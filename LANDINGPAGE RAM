<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ram Dasx - Gaming Hub</title>
  <style>
    /* Reset and base styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #0f0f0f;
      color: #ffffff;
      scroll-behavior: smooth;
    }
    a {
      color: inherit;
      text-decoration: none;
    }

    /* Navigation */
    nav {
      position: fixed;
      top: 0;
      width: 100%;
      background-color: #1a1a1a;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      z-index: 1000;
    }
    .logo {
      font-size: 1.5rem;
      font-weight: bold;
      color: #00ffcc;
    }
    .nav-links {
      display: flex;
      gap: 1.5rem;
    }
    .nav-links a {
      color: #ffffff;
      transition: color 0.3s;
    }
    .nav-links a:hover {
      color: #00ffcc;
    }

    /* Hero Section */
    .hero {
      height: 100vh;
      background: url('https://source.unsplash.com/1600x900/?gaming,neon') center/cover no-repeat;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 1rem;
    }
    .hero h1 {
      font-size: 3rem;
      color: #00ffcc;
      margin-bottom: 1rem;
      animation: fadeInDown 1s ease-in-out;
    }
    .hero p {
      font-size: 1.25rem;
      max-width: 600px;
      margin-bottom: 2rem;
      animation: fadeInUp 1s ease-in-out;
    }
    .hero button {
      padding: 0.75rem 1.5rem;
      font-size: 1rem;
      background-color: #00ffcc;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s;
      animation: fadeInUp 1.2s ease-in-out;
    }
    .hero button:hover {
      background-color: #00cc99;
    }

    /* Game Section */
    .game-section {
      padding: 4rem 2rem;
      background-color: #1a1a1a;
      text-align: center;
    }
    .game-section h2 {
      font-size: 2rem;
      margin-bottom: 2rem;
      color: #00ffcc;
    }
    .game-container {
      display: flex;
      justify-content: center;
    }
    .game-container iframe {
      width: 800px;
      height: 600px;
      border: none;
      border-radius: 10px;
    }

    /* Footer */
    footer {
      background-color: #0f0f0f;
      text-align: center;
      padding: 1rem;
      color: #666666;
    }

    /* Animations */
    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Responsive */
    @media (max-width: 850px) {
      .game-container iframe {
        width: 100%;
        height: 400px;
      }
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <nav>
    <div class="logo">Ram Dasx</div>
    <div class="nav-links">
      <a href="#home">Home</a>
      <a href="#games">Games</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero" id="home">
    <h1>Welcome to Ram Dasx</h1>
    <p>Experience the thrill of gaming with our interactive adventures.</p>
    <button onclick="document.getElementById('games').scrollIntoView({ behavior: 'smooth' });">Play Now</button>
  </section>

  <!-- Game Section -->
  <section class="game-section" id="games">
    <h2>Featured Game</h2>
    <div class="game-container">
      <iframe src="https://www.retrogames.cc/embed/30299-sonic-the-hedgehog-usa-europe.html" allowfullscreen></iframe>
    </div>
  </section>

  <!-- Footer -->
  <footer id="contact">
    <p>&copy; 2025 Ram Dasx. All rights reserved.</p>
  </footer>

</body>
</html>
